% ---------- \perceptron ---------------------------------------------------
\newcommand{\perceptron}{%
\begin{tikzpicture}
  \node[neuronio entrada] (px1) at (0, 1.9)  {$x_1$};
  \node[neuronio entrada] (px2) at (0, 0.95) {$x_2$};
  \node                   (pxd) at (0, 0.18) {$\vdots$};
  \node[neuronio entrada] (pxn) at (0,-0.75) {$x_N$};
  \node[circle, draw=icCinza, fill=icFundo, minimum size=0.6cm,
        font=\small] (pb) at (2.1, 2.15) {$1$};
  \node[neuronio, minimum size=1cm] (psoma) at (2.1, 0.55) {$\Sigma$};
  \node[neuronio, minimum size=1cm] (pativ) at (3.8, 0.55) {$\ativ(\cdot)$};
  \node (pout) at (5.5, 0.55) {$\hat{y}$};
  \draw[sinapse] (px1) -- node[peso, pos=0.45] {$w_1$} (psoma);
  \draw[sinapse] (px2) -- node[peso, pos=0.45] {$w_2$} (psoma);
  \draw[sinapse] (pxn) -- node[peso, pos=0.45] {$w_N$} (psoma);
  \draw[sinapse] (pb)  -- node[peso, pos=0.45] {$b$}   (psoma);
  \draw[sinapse] (psoma) -- node[peso, above] {$\campo$} (pativ);
  \draw[sinapse destac] (pativ) -- (pout);
\end{tikzpicture}}

% ---------- \mlp{n1,n2,...} ------------------------------------------------
\makeatletter
\newcommand{\mlp}[1]{%
\begin{tikzpicture}[x=1.7cm, y=0.85cm]
  % conta as camadas
  \xdef\ic@nlayers{0}%
  \foreach \n in {#1} {\xdef\ic@nlayers{\the\numexpr\ic@nlayers+1\relax}}%
  % nós
  \foreach \n [count=\li] in {#1} {%
    \pgfmathsetmacro{\ic@off}{(\n-1)/2}%
    \ifnum\li=1
      \foreach \j in {1,...,\n}
        \node[neuronio entrada, minimum size=0.62cm]
          (n-\li-\j) at (\li, {\ic@off-(\j-1)}) {};
    \else
      \ifnum\li=\ic@nlayers\relax
        \foreach \j in {1,...,\n}
          \node[neuronio saida, minimum size=0.62cm]
            (n-\li-\j) at (\li, {\ic@off-(\j-1)}) {};
      \else
        \foreach \j in {1,...,\n}
          \node[neuronio, minimum size=0.62cm]
            (n-\li-\j) at (\li, {\ic@off-(\j-1)}) {};
      \fi
    \fi
  }%
  % arestas
  \foreach \n [count=\li, remember=\n as \ic@nprev (initially 0),
               remember=\li as \ic@lprev (initially 0)] in {#1} {%
    \ifnum\li>1
      \foreach \i in {1,...,\ic@nprev}
        \foreach \j in {1,...,\n}
          \draw[icCinza!60, semithick] (n-\ic@lprev-\i) -- (n-\li-\j);
    \fi
  }%
\end{tikzpicture}}
\makeatother

% ---------- \cicloevolutivo --------------------------------------------------
\newcommand{\cicloevolutivo}{%
\begin{tikzpicture}[node distance=0.9cm and 1.5cm]
  \node[bloco evol] (pop)  {População $\pop(\geracao)$};
  \node[bloco evol, right=of pop]  (aval) {Avaliação\\ (aptidão $\apt$)};
  \node[bloco evol, below=of aval] (sel)  {Seleção};
  \node[bloco evol, left=of sel]   (var)  {Cruzamento $\pcruz$\\ Mutação $\pmut$};
  \node[bloco, right=1.3cm of aval] (fim) {Critério de\\ parada};
  \draw[fluxo] (pop)  -- (aval);
  \draw[fluxo] (aval) -- (sel);
  \draw[fluxo] (sel)  -- (var);
  \draw[fluxo] (var)  -- (pop);
  \draw[fluxo] (aval) -- (fim);
\end{tikzpicture}}

