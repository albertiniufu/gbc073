% ---------- página de título --------------------------------------------
\defbeamertemplate*{title page}{ic}[1][]{%
  \begin{tikzpicture}[remember picture, overlay]
    % decoração: rede neural esmaecida no canto direito
    \begin{scope}[shift={($(current page.south east)+(-3.4,1.1)$)}, opacity=0.5]
      \foreach \j in {1,2,3}
        \node[circle, draw=icAzul!25, fill=icAzul!8, minimum size=0.55cm]
          (tp-a-\j) at (0, \j*0.95) {};
      \foreach \j in {1,2,3,4}
        \node[circle, draw=icAzul!25, fill=icAzul!8, minimum size=0.55cm]
          (tp-b-\j) at (1.25, \j*0.95-0.48) {};
      \foreach \j in {1,2}
        \node[circle, draw=icMagenta!30, fill=icMagenta!8, minimum size=0.55cm]
          (tp-c-\j) at (2.5, \j*0.95+0.48) {};
      \foreach \i in {1,2,3} \foreach \j in {1,2,3,4}
        \draw[icAzul!18] (tp-a-\i) -- (tp-b-\j);
      \foreach \i in {1,2,3,4} \foreach \j in {1,2}
        \draw[icAzul!18] (tp-b-\i) -- (tp-c-\j);
    \end{scope}
    % filete superior
    \fill[icAzul] (current page.north west) rectangle
      ($(current page.north east)+(0,-0.18)$);
    \fill[icMagenta] (current page.north west) rectangle
      ($(current page.north west)+(4.2,-0.18)$);
  \end{tikzpicture}%
  \vspace{1.4cm}
  \begin{minipage}{0.92\textwidth}
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \vspace{0.45em}
    {\color{icMagenta}\rule{3.2cm}{2.2pt}\par}
    \vspace{0.55em}
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
    \vspace{1.6em}
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
    \vspace{0.35em}
    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
    \vspace{0.35em}
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
  \end{minipage}
}

% ---------- divisória automática de seção ---------------------------------
\AtBeginSection[]{{%
  \setbeamercolor{background canvas}{bg=icAzul}%
  \begin{frame}[plain, noframenumbering]
    \begin{tikzpicture}[remember picture, overlay]
      \begin{scope}[shift={($(current page.south east)+(-3.2,0.9)$)}]
        \foreach \j in {1,2,3}
          \node[circle, draw=white, opacity=0.16, minimum size=0.5cm]
            (sd-a-\j) at (0, \j*0.85) {};
        \foreach \j in {1,2}
          \node[circle, draw=white, opacity=0.16, minimum size=0.5cm]
            (sd-b-\j) at (1.3, \j*0.85+0.42) {};
        \foreach \i in {1,2,3} \foreach \j in {1,2}
          \draw[white, opacity=0.12] (sd-a-\i) -- (sd-b-\j);
      \end{scope}
    \end{tikzpicture}%
    \vfill
    {\color{icDourado}\bfseries\large PARTE \insertsectionnumber\par}
    \vspace{0.5em}
    {\color{white}\bfseries\huge \insertsection\par}
    \vspace{0.6em}
    {\color{icAzulClaro!40!white}\rule{2.6cm}{2pt}\par}
    \vfill
  \end{frame}
}}

